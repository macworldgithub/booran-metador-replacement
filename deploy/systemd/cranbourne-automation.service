[Unit]
Description=Cranbourne automation API and DealerSocket browser worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=cranbourne
Group=cranbourne
WorkingDirectory=/var/www/cranbourne/current/automation
EnvironmentFile=/etc/cranbourne/automation.env
Environment=HOME=/var/lib/cranbourne
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/cranbourne/browsers
# The existing connector may open headed Chrome during automatic login.
# Xvfb supplies a private display on a VPS without a desktop environment.
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1440x900x24 -nolisten tcp" /var/www/cranbourne/current/automation/.venv/bin/python /var/www/cranbourne/current/automation/run_connector.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
UMask=0077
StateDirectory=cranbourne
StateDirectoryMode=0700
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cranbourne
# Chrome's user-namespace sandbox needs permission to create namespaces.
# Do not add --no-sandbox, RestrictNamespaces, or a syscall filter here.
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
