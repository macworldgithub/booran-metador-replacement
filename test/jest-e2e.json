{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": "<rootDir>/esm-transformer.cjs"
  },
  "transformIgnorePatterns": [
    "node_modules[/\\\\](?!@nestjs[/\\\\](jwt|passport|schedule|mongoose|swagger)[/\\\\])"
  ]
}
