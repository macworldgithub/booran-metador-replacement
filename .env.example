# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/matador-replacement

# JWT & Authentication
JWT_SECRET=booran-matador-replacement-jwt-secret-key-2026!
JWT_EXPIRES_IN=8h

# Mobile Message: disabled until provider account/numbers/webhooks are configured.
MOBILEMESSAGE_ENABLED=false
# Optional one-way test recipient: restrict sends to this handset and pause automated SMS.
# Remove when the complete integration is ready for production.
MOBILEMESSAGE_TEST_RECIPIENT=
MOBILEMESSAGE_API_USERNAME=
MOBILEMESSAGE_API_PASSWORD=
MOBILEMESSAGE_WEBHOOK_SECRET=
# Use three distinct dedicated reply-capable numbers assigned by Mobile Message.
SMS_KIA_NUMBER=
SMS_MG_NUMBER=
SMS_GEELY_NUMBER=
# Provider dashboard callbacks (public HTTPS):
# /api/sms/inbound and /api/sms/delivery-receipt


# DealerSocket CRM Solera Write-Back API (Leave empty/default for simulation mode)
DEALERSOCKET_WRITEBACK_ENABLED=false
DS_API_BASE_URL=https://api.dealersocket.com
DS_CLIENT_ID=xxxxxxxxxxxxxxxx
DS_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# Authenticates DealerSocket scraper ingestion and heartbeat calls.
LEAD_FORWARD_SECRET=replace-with-a-long-random-secret

DEALERSOCKET_CONNECTOR_URL=https://cranbourne-automation.omnisuiteai.com

# Password-reset email. Keep the real password only in the production env.
MESSAGE_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public frontend origin used for /reset-password links.
FRONTEND_URL=https://your-portal.example.com
